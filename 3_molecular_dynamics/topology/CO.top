; name  at.num  mass     charge ptype  sigma      epsilon (Lennard-Jones - generic)
A1       1      12.010   0.000  A      0.33       0.00  ; Dummy LJ
A2       17     16.000   0.000  A      0.33       0.00  ; Dummy LJ

[ moleculetype ]
; Name            nrexcl
CO             3

[ atoms ]
