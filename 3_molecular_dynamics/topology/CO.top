     1         A1      1    CO     C      1      0.000      12.010
     2         A2      1    CO     O      1      0.000      16.000

[ bonds ]
;  ai    aj funct            c0            c1 (k)
    1     2     1      0.1128   1120000.0

[ system ]
; Name
CO Simulation

[ molecules ]
