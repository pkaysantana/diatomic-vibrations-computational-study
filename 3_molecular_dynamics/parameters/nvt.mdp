; --- GROMACS NVt Parameters for Diatomic Vibration ---
integrator              = md        ; Leap-frog integrator
dt                      = 0.0005    ; 0.5 fs (needed for high freq H-Cl vibration)
nsteps                  = 200000    ; 100 ps total simulation time

; --- Output Control (Crucial for FFT) ---
nstxout                 = 1         ; Save coordinates every step (0.5 fs)
nstvout                 = 1         ; Save velocities every step
nstenergy               = 100
nstlog                  = 100

; --- Neighbor Searching & Electrostatics ---
cutoff-scheme           = Verlet    ; Required for GPU acceleration
nstlist                 = 100       ; Frequency to update neighbor list
ns_type                 = grid
vdwtype                 = Cut-off
rvdw                    = 1.0
coulombtype             = Cut-off   ; Simple cutoff is fine for a single molecule
rcoulomb                = 1.0

; --- Temperature Coupling ---
tcoupl                  = V-rescale ; Velocity rescaling thermostat
tc-grps                 = System
tau_t                   = 0.1       ; Time constant
ref_t                   = 300       ; Target temperature (Kelvin)

; --- Bond Settings (The "Don't Break" rule) ---
constraints             = none      ; MUST be none to see vibrations
continuation            = no
