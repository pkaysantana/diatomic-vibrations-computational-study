; NVT Simulation Parameters (Optimized for NVIDIA RTX 5070 Ti)
integrator  = md
dt          = 0.002
nsteps      = 50000
nstxout     = 500
nstvout     = 500
nstfout     = 500
nstenergy   = 500

; Temperature coupling is on
tcoupl      = V-rescale
tc-grps     = System
tau_t       = 0.1
ref_t       = 300

; Pressure coupling is off
pcoupl      = no

; Electrostatics
coulombtype = PME
rcoulomb    = 1.0

; Van der Waals
vdwtype     = Cut-off
rvdw        = 1.0

; Periodic boundary conditions
pbc         = xyz

; GPU Optimization Settings
cutoff-scheme           = Verlet
verlet-buffer-tolerance = 0.005
nstlist                 = 40      ; Increased neighbor searching interval for GPU efficiency
ns_type                 = grid
pme_order               = 4
ewald_rtol              = 1e-5
fourierspacing          = 0.12
