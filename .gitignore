*.tmp
*.gbw
*.prop
*.hess
*.pc
*.opt
*.bas
*.dens
*.vbi

# GROMACS temporary/binary files
*.trr
*.xtc
*.edr
*.tpr
*.cpt
# Note: Keep .gro and .top as they are small topology/coord files

